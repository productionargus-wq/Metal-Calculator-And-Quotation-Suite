{
  "name": "metal-weight-quotation-suite",
  "version": "1.0.0",
  "description": "Full-stack Metal Weight & Quotation Suite using Express and MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "nodemon server.js",
    "build:exe": "node build_standalone_exe.js",
    "bundle:backend": "npx esbuild server.js --bundle --platform=node --target=node20 --outfile=backend_bundle.js",
    "build:mobile": "npm --prefix mobile-app run prepare-mobile"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.6.3",
    "mongoose": "^8.2.1",
    "multer": "^2.4.0",
    "nodemailer": "^6.10.1",
    "nodemon": "^3.1.14",
    "resend": "^6.25.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0"
  }
}
